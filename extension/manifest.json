{
  "manifest_version": 3,
  "name": "Vercel Destekli YT Engelleyici",
  "version": "1.0",
  "description": "Eğitim amaçlı, kurallarını Vercel'den çeken ad-blocker projesi.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://*.youtube.com/*",
    "*://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}
